# ==========================================================
# 灵鲸鲸 .env
# 原则：需要模型的能力一律「留空即降级」，不硬依赖任何外部模型。
# 想接哪个就填哪个，不填也能跑（只是那个能力走占位实现并明确告知）。
# ==========================================================

LING_HOST=127.0.0.1
LING_PORT=7100
LING_AUTH_TOKEN=lingjingjing-local-dev
LING_DATA_DIR=data

# ---------- 对话模型 ----------
# 留空 = 使用 echo 占位（只会复述，不是 AI）。填了才走真实模型。
# 支持任意 OpenAI 兼容接口。示例（任选其一，不要都填）：
#
#   本地 Ollama：
#     LING_MODEL_PROVIDER=openai_compatible
#     LING_MODEL_BASE_URL=http://127.0.0.1:11434/v1
#     LING_MODEL_NAME=qwen2.5:7b-instruct-q4_K_M
#
#   云端 API（DeepSeek 示例）：
#     LING_MODEL_PROVIDER=openai_compatible
#     LING_MODEL_BASE_URL=https://api.deepseek.com/v1
#     LING_MODEL_NAME=deepseek-chat
#     LING_MODEL_API_KEY=sk-xxxx
LING_MODEL_PROVIDER=echo
LING_MODEL_NAME=
LING_MODEL_BASE_URL=
LING_MODEL_API_KEY=
LING_MODEL_TIMEOUT_SECONDS=60

# ---------- 生图 ----------
# 留空 = 使用 MockBackend（画的是占位图形，不是 AI 绘画）。
#   接 ComfyUI：LING_COMFYUI_URL=http://127.0.0.1:8188
LING_COMFYUI_URL=
LING_IMAGE_BACKEND=
LING_IMAGE_DAILY_BUDGET=10
LING_IMAGE_TIMEOUT_SECONDS=120

# ---------- 语音 ----------
# 留空 = Mock（合成的是提示音，不是真实人声）。
LING_SPEECH_ASR_BACKEND=
LING_SPEECH_TTS_BACKEND=

# ---------- 视频 ----------
# 留空 = mock 数据源（预置样例，不是真实 B 站内容）。
#   LING_VIDEO_SOURCE=bilibili 使用真实来源
LING_VIDEO_SOURCE=

# ---------- 运行参数 ----------
LING_HEARTBEAT_SECONDS=15
LING_QUIET_HOURS=23:30-07:30
LING_STATE_UTC_OFFSET_MINUTES=480
LING_STATE_CITY=Asia/Shanghai
LING_PROACTIVE_ENABLED=true
